{
  "expo": {
    "name": "Tabsy",
    "slug": "tabsy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tabsy",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#EFF5ED"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tabsy.app",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Tabsy uses speech recognition to convert your voice into text for expense entry.",
        "NSMicrophoneUsageDescription": "Tabsy needs microphone access for voice input."
      }
    },
    "android": {
      "package": "com.tabsy.app",
      "adaptiveIcon": {
        "backgroundColor": "#183327",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/manrope.ttf",
            "./assets/fonts/jetbrains-mono.ttf"
          ]
        }
      ],
      "expo-secure-store",
      "./plugins/withQuickAdd",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Tabsy needs microphone access for voice input.",
          "speechRecognitionPermission": "Tabsy uses speech recognition to convert your voice into text for expense entry."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5edc39e1-5a7a-473d-a66c-d655c677ac9d"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5edc39e1-5a7a-473d-a66c-d655c677ac9d"
    }
  }
}
